# Shell scripts must keep LF endings — CRLF breaks them under WSL/CI
# (core.autocrlf=true would otherwise rewrite working copies to CRLF).
*.sh text eol=lf

# Files excluded from `git archive` (source tarballs and release bundles).
# These are internal development/tooling files not needed by end users.
.claude/                        export-ignore
CLAUDE.md                       export-ignore
PLAN.md                         export-ignore
gse-profiler_code_review.md     export-ignore
docs/                           export-ignore
